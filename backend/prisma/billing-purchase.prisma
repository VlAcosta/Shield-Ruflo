enum BillingPurchaseRequestStatus {
  OPEN
  CONTACTED
  INVOICED
  COMPLETED
  CANCELED

  @@map("billing_purchase_request_status")
}

model BillingPurchaseRequest {
  id                    String                       @id @default(uuid()) @db.Uuid
  organizationId        String                       @map("organization_id") @db.Uuid
  requestedByUserId     String                       @map("requested_by_user_id") @db.Uuid
  planCode              String                       @map("plan_code") @db.VarChar(80)
  billingInterval       String                       @map("billing_interval") @db.VarChar(24)
  quotedAmountCents     Int                          @map("quoted_amount_cents")
  currency              String                       @default("RUB") @db.VarChar(3)
  status                BillingPurchaseRequestStatus @default(OPEN)
  idempotencyKey        String                       @unique @map("idempotency_key") @db.VarChar(200)
  contactEmail          String?                      @map("contact_email") @db.VarChar(320)
  contactPhone          String?                      @map("contact_phone") @db.VarChar(64)
  requestedReturnUrl    String?                      @map("requested_return_url") @db.Text
  metadata              Json?
  contactedAt           DateTime?                    @map("contacted_at")
  invoicedAt            DateTime?                    @map("invoiced_at")
  completedAt           DateTime?                    @map("completed_at")
  canceledAt            DateTime?                    @map("canceled_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  @@index([organizationId, status, createdAt], map: "billing_purchase_requests_org_status_created_idx")
  @@index([requestedByUserId, createdAt], map: "billing_purchase_requests_user_created_idx")
  @@map("billing_purchase_requests")
}
