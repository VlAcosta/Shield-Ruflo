model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(80)
  name       String   @db.VarChar(160)
  priceCents Int      @default(0) @map("price_cents")
  currency   String   @default("RUB") @db.VarChar(3)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  entitlements Entitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

model Entitlement {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String   @db.VarChar(120)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key], map: "entitlements_plan_key_key")
  @@map("entitlements")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               String?            @db.VarChar(80)
  externalCustomerId     String?            @map("external_customer_id") @db.VarChar(240)
  externalSubscriptionId String?            @map("external_subscription_id") @db.VarChar(240)
  currentPeriodStart     DateTime?           @map("current_period_start")
  currentPeriodEnd       DateTime?           @map("current_period_end")
  autoRenew              Boolean             @default(false) @map("auto_renew")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, status], map: "subscriptions_org_status_idx")
  @@unique([provider, externalSubscriptionId], map: "subscriptions_provider_external_key")
  @@map("subscriptions")
}

model Usage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(120)
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  value          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, periodStart, periodEnd], map: "usage_org_key_period_key")
  @@index([organizationId, key, periodEnd], map: "usage_org_key_end_idx")
  @@map("usage")
}
