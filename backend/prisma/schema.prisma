  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User         @relation("TaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt], map: "task_comments_org_created_idx")
  @@index([taskId, createdAt], map: "task_comments_task_created_idx")
