  @@index([locationId, status], map: "tasks_location_status_idx")
  @@map("tasks")
}

model TaskAssignee {
  taskId               String @map("task_id") @db.Uuid
  organizationMemberId String @map("organization_member_id") @db.Uuid
  assignedAt           DateTime @default(now()) @map("assigned_at")

  task   Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation("TaskAssigneeMember", fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@id([taskId, organizationMemberId])
  @@index([organizationMemberId, assignedAt], map: "task_assignees_member_assigned_idx")
  @@map("task_assignees")
}

model TaskComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  text           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
