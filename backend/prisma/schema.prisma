model IntegrationAccount {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  provider          String            @db.VarChar(80)
  name              String            @db.VarChar(180)
  externalAccountId String?           @map("external_account_id") @db.VarChar(240)
  status            IntegrationStatus @default(DISCONNECTED)
  configuration     Json?
  lastValidatedAt   DateTime?         @map("last_validated_at")
  lastSyncedAt      DateTime?         @map("last_synced_at")
  lastErrorCode     String?           @map("last_error_code") @db.VarChar(120)
  lastErrorMessage  String?           @map("last_error_message") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials  IntegrationCredential[]
  syncRuns     IntegrationSyncRun[]
  events       IntegrationEvent[]

  @@unique([organizationId, provider, externalAccountId], map: "integration_accounts_org_provider_external_key")
  @@index([organizationId, status], map: "integration_accounts_org_status_idx")
  @@map("integration_accounts")
}

model IntegrationCredential {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  key             String   @db.VarChar(120)
  encryptedValue  String   @map("encrypted_value") @db.Text
  keyVersion      Int      @default(1) @map("key_version")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key], map: "integration_credentials_account_key_key")
  @@map("integration_credentials")
}

model IntegrationSyncRun {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  accountId      String                @map("account_id") @db.Uuid
  status         IntegrationSyncStatus @default(QUEUED)
  trigger        String                @default("manual") @db.VarChar(80)
  importedCount  Int                   @default(0) @map("imported_count")
  updatedCount   Int                   @default(0) @map("updated_count")
  skippedCount   Int                   @default(0) @map("skipped_count")
  errorCount     Int                   @default(0) @map("error_count")
  errorCode      String?               @map("error_code") @db.VarChar(120)
  errorMessage   String?               @map("error_message") @db.Text
  startedAt      DateTime?             @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt], map: "integration_sync_runs_org_status_created_idx")
  @@index([accountId, createdAt], map: "integration_sync_runs_account_created_idx")
  @@map("integration_sync_runs")
}

model IntegrationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  type           String   @db.VarChar(120)
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      IntegrationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt], map: "integration_events_org_created_idx")
  @@index([accountId, createdAt], map: "integration_events_account_created_idx")
  @@map("integration_events")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String    @db.VarChar(120)
  payload        Json
  status         JobStatus @default(QUEUED)
  dedupeKey      String?   @map("dedupe_key") @db.VarChar(240)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  runAt          DateTime  @default(now()) @map("run_at")
  lockedAt       DateTime? @map("locked_at")
  lockToken      String?   @map("lock_token") @db.VarChar(120)
  lastError      String?   @map("last_error") @db.Text
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey], map: "jobs_org_dedupe_key")
  @@index([status, runAt], map: "jobs_status_run_at_idx")
  @@index([organizationId, createdAt], map: "jobs_org_created_idx")
  @@map("jobs")
}

model Automation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(180)
  trigger        String   @db.VarChar(120)
  conditions     Json
  actions        Json
  enabled        Boolean  @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organizationId, enabled], map: "automations_org_enabled_idx")
  @@index([organizationId, trigger], map: "automations_org_trigger_idx")
  @@map("automations")
}

model AutomationExecution {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  automationId   String                    @map("automation_id") @db.Uuid
  status         AutomationExecutionStatus @default(RUNNING)
  dedupeKey      String                    @map("dedupe_key") @db.VarChar(240)
  triggerPayload Json?                     @map("trigger_payload")
  actionResult   Json?                     @map("action_result")
  errorMessage   String?                   @map("error_message") @db.Text
  startedAt      DateTime                  @default(now()) @map("started_at")
  finishedAt     DateTime?                 @map("finished_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, dedupeKey], map: "automation_executions_automation_dedupe_key")
  @@index([organizationId, startedAt], map: "automation_executions_org_started_idx")
  @@map("automation_executions")
}

model Report {
