enum ServiceAccountStatus {
  ACTIVE
  REVOKED

  @@map("service_account_status")
}

model ServiceAccount {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  name            String               @db.VarChar(160)
  description     String?              @db.VarChar(500)
  status          ServiceAccountStatus @default(ACTIVE)
  permissions     Json
  expiresAt       DateTime?            @map("expires_at")
  revokedAt       DateTime?            @map("revoked_at")
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  apiKeys         ServiceAccountApiKey[]

  @@index([organizationId, status], map: "service_accounts_org_status_idx")
  @@index([expiresAt], map: "service_accounts_expires_idx")
  @@map("service_accounts")
}

model ServiceAccountApiKey {
  id               String         @id @default(uuid()) @db.Uuid
  serviceAccountId String         @map("service_account_id") @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  name             String         @db.VarChar(160)
  prefix           String         @unique @db.VarChar(24)
  tokenHash        String         @unique @map("token_hash") @db.Char(64)
  permissions      Json
  expiresAt        DateTime?      @map("expires_at")
  lastUsedAt       DateTime?      @map("last_used_at")
  revokedAt        DateTime?      @map("revoked_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt], map: "service_account_api_keys_org_revoked_idx")
  @@index([serviceAccountId, revokedAt], map: "service_account_api_keys_account_revoked_idx")
  @@index([expiresAt], map: "service_account_api_keys_expires_idx")
  @@map("service_account_api_keys")
}
