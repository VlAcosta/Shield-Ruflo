# Business Shield backend production environment
# Copy to backend/.env on the server. Never commit the real .env.

NODE_ENV=production
APP_NAME="Business Shield API"
APP_VERSION=0.9.0
HOST=127.0.0.1
PORT=8081
TRUST_PROXY=loopback
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://business_shield:CHANGE_ME@127.0.0.1:5434/business_shield

# Public web origin
CORS_ORIGINS=https://bis-shield.ru
SWAGGER_ENABLED=false

# Platform-admin access. Comma-separated login identities (email and/or phone).
# Empty means /admin is denied for everyone.
PLATFORM_ADMIN_IDENTITIES=

# Operations metrics and expensive-AI request budgets.
OPERATIONS_METRICS_TOKEN=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
AI_RATE_LIMIT_USER_PER_MINUTE=20
AI_RATE_LIMIT_TENANT_PER_MINUTE=100

# HttpOnly session authentication
AUTH_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=bs_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# OTP. Recommended production mode: Exolve Voice API.
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_IP_MAX_REQUESTS=10
AUTH_OTP_IP_WINDOW_SECONDS=600
AUTH_OTP_PROVIDER=exolve_voice
AUTH_OTP_FIXED_CODE=
AUTH_EXPOSE_DEBUG_CODE=false
EXOLVE_API_KEY=CHANGE_ME
EXOLVE_SOURCE_NUMBER=74959999999
EXOLVE_TIMEOUT_MS=5000
EXOLVE_TTS_VOICE=2
EXOLVE_TTS_SPEED=0.85
AUTH_OTP_WEBHOOK_URL=
AUTH_OTP_WEBHOOK_TOKEN=
AUTH_OTP_WEBHOOK_TIMEOUT_MS=5000

# Company lookup.
COMPANY_LOOKUP_PROVIDER=disabled
DADATA_API_KEY=
DADATA_TIMEOUT_MS=6500
FNS_NPD_TIMEOUT_MS=65000
COMPANY_LOOKUP_WEBHOOK_URL=
COMPANY_LOOKUP_WEBHOOK_TOKEN=
COMPANY_LOOKUP_WEBHOOK_TIMEOUT_MS=5000

# Integration credentials are tenant-scoped and encrypted in PostgreSQL.
# WB/Ozon/2GIS/Yandex/Otzovik secrets are entered in the Integrations UI/API,
# not stored as global server environment variables.
INTEGRATION_CREDENTIALS_KEY=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
INTEGRATION_SYNC_SCHEDULER_ENABLED=true
INTEGRATION_SYNC_POLL_SECONDS=30
INTEGRATION_SYNC_DEFAULT_INTERVAL_MINUTES=30
# Yandex/Otzovik bridge endpoints are disabled until their exact HTTPS hosts
# are explicitly allowlisted here (comma-separated hostnames, no scheme/path).
REVIEW_BRIDGE_ALLOWED_HOSTS=

# Google Business Profile global OAuth application.
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=https://bis-shield.ru/api/v1/integrations/providers/google-business-profile/oauth/callback
GOOGLE_BUSINESS_RETURN_URL=https://bis-shield.ru/integrations
GOOGLE_BUSINESS_TIMEOUT_MS=10000

# Google Places live source used by Competitive Intelligence.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=10000

# Scheduled reports.
REPORT_SCHEDULER_ENABLED=true
REPORT_SCHEDULER_POLL_SECONDS=30
# disabled | resend | webhook
REPORT_EMAIL_PROVIDER=disabled
REPORT_EMAIL_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_WEBHOOK_URL=
REPORT_EMAIL_WEBHOOK_TOKEN=
# Bot token for Telegram scheduled report delivery. Destination is configured per schedule.
REPORT_TELEGRAM_BOT_TOKEN=

# Product suggestions are always persisted to PostgreSQL first.
# Optional webhook mirrors new suggestions to the support/helpdesk system.
SUGGESTION_WEBHOOK_URL=
SUGGESTION_WEBHOOK_TOKEN=

# Shield AI Review Intelligence / Reply Copilot / AI Visibility / Ask Shield.
AI_REVIEW_INTELLIGENCE_ENABLED=false
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_OPENAI_TIMEOUT_MS=30000
AI_OPENAI_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
AI_OPENAI_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
