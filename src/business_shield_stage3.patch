+@use '../../../styles/tokens' as *;
+@use '../../../styles/mixins' as *;
+
+.period-menu {
+  position: relative;
+  display: inline-flex;
+  min-width: 0;
+
+  &__trigger {
+    @include focus-ring;
+    height: 31px;
+    padding: 0 9px 0 10px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 6px;
+    border: 1px solid rgba(224, 228, 241, .92);
+    border-radius: 10px;
+    color: $color-text-secondary;
+    background: rgba(248, 249, 253, .82);
+    cursor: pointer;
+    font-size: 10.5px;
+    font-weight: 620;
+    letter-spacing: -.018em;
+    white-space: nowrap;
+    transition:
+      color $transition-fast,
+      border-color $transition-fast,
+      background $transition-fast,
+      box-shadow $transition-fast,
+      transform $transition-fast;
+
+    svg {
+      width: 13px;
+      height: 13px;
+      transition: transform $transition-spring;
+    }
+
+    &:hover {
+      color: $color-text;
+      border-color: #d8ddee;
+      background: #fff;
+      box-shadow: 0 7px 18px rgba(34, 43, 88, .055);
+    }
+
+    &:active {
+      transform: translateY(1px);
+    }
+  }
+
+  &.is-open &__trigger {
+    color: $color-primary;
+    border-color: rgba(102, 97, 245, .27);
+    background: #fff;
+    box-shadow: 0 9px 24px rgba(58, 53, 154, .085);
+
+    svg { transform: rotate(180deg); }
+  }
+
+  &__popover {
+    position: absolute;
+    top: calc(100% + 7px);
+    z-index: 80;
+    width: 180px;
+    padding: 6px;
+    border: 1px solid rgba(222, 226, 239, .88);
+    border-radius: 14px;
+    background: rgba(255, 255, 255, .96);
+    box-shadow: 0 20px 50px rgba(34, 43, 88, .14);
+    backdrop-filter: blur(18px);
+    animation: period-menu-enter 190ms cubic-bezier(.16, 1, .3, 1) both;
+  }
+
+  &--right &__popover { right: 0; }
+  &--left &__popover { left: 0; }
+
+  &__option {
+    width: 100%;
+    min-height: 41px;
+    padding: 7px 8px 7px 10px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 10px;
+    border: 0;
+    border-radius: 9px;
+    color: $color-text-secondary;
+    background: transparent;
+    cursor: pointer;
+    text-align: left;
+    transition: color $transition-fast, background $transition-fast;
+
+    > span {
+      min-width: 0;
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    strong {
+      color: inherit;
+      font-size: 10.5px;
+      font-weight: 650;
+      line-height: 1.1;
+      letter-spacing: -.018em;
+    }
+
+    small {
+      color: $color-text-muted;
+      font-size: 8.5px;
+      font-weight: 500;
+      line-height: 1.2;
+    }
+
+    i {
+      width: 7px;
+      height: 7px;
+      flex: 0 0 auto;
+      border-radius: 50%;
+      background: transparent;
+      box-shadow: inset 0 0 0 1px $color-border-strong;
+    }
+
+    &:hover {
+      color: $color-text;
+      background: $color-surface-soft;
+    }
+
+    &.is-active {
+      color: $color-primary;
+      background: rgba(102, 97, 245, .07);
+
+      i {
+        background: $color-primary;
+        box-shadow: 0 0 0 3px rgba(102, 97, 245, .09);
+      }
+    }
+  }
+
+  &--quiet &__trigger {
+    height: auto;
+    padding: 2px 0;
+    border: 0;
+    border-radius: 6px;
+    color: $color-text-muted;
+    background: transparent;
+    box-shadow: none;
+    font-size: 10px;
+    font-weight: 540;
+
+    &:hover {
+      color: $color-primary;
+      background: transparent;
+      box-shadow: none;
+    }
+  }
+
+  &--quiet.is-open &__trigger {
+    background: transparent;
+    box-shadow: none;
+  }
+}
+
+@keyframes period-menu-enter {
+  from { opacity: 0; transform: translateY(-5px) scale(.985); }
+  to { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .period-menu__popover,
+  .period-menu__trigger,
+  .period-menu__trigger svg {
+    animation: none;
+    transition: none;
+  }
+}
