n","email":"james@hugman.tv"},"directories":{},"maintainers":[{"name":"jhugman","email":"james@hugman.tv"}],"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/core_0.31.0-3_1779822562088_0.38331471726421085"},"_hasShrinkwrap":false}},"time":{"created":"2026-05-26T19:09:21.937Z","0.31.0-3":"2026-05-26T19:09:22.262Z","modified":"2026-05-26T19:09:22.661Z"},"maintainers":[{"name":"jhugman","email":"james@hugman.tv"}],"description":"Runtime support for uniffi-bindgen-javascript generated bindings.","homepage":"https://github.com/jhugman/uniffi-bindgen-react-native","keywords":["uniffi","ffi","rust","react-native","typescript"],"repository":{"type":"git","url":"git+https://github.com/jhugman/uniffi-bindgen-react-native.git","directory":"typescript"},"author":{"name":"James Hugman","email":"james@hugman.tv"},"bugs":{"url":"https://github.com/jhugman/uniffi-bindgen-react-native/issues"},"license":"MPL-2.0","readme":"# @ubjs/core\n\nRuntime support for [`uniffi-bindgen-javascript`][bindgen] generated\nbindings. Imported by generated TypeScript code; not intended for\ndirect use.\n\n[bindgen]: https://github.com/jhugman/uniffi-bindgen-react-native\n\n## Compatibility\n\nShips dual ESM/CJS builds via an `exports` field; works in Node ≥18,\nBun, React Native (Metro, RN ≥0.71), and modern web bundlers.\n\n## Relationship to `uniffi-bindgen-react-native`\n\n`@ubjs/core` and `uniffi-bindgen-react-native` ship the same runtime\nbytes under different package names. The legacy name remains on npm\nso older generated code keeps resolving its imports; new generated\ncode imports `@ubjs/core`. They are version-locked.\n\n## Install\n\nYou should not install this directly. Your generated bindings list\n`@ubjs/core` as a peer requirement when you regenerate them with a\nrecent `ubrn` CLI.\n\n```bash\nnpm install @ubjs/core\n```\n","readmeFilename":"README.md","_rev":"1-5149b0ac3f71a489fcd29a8806a183a3"}